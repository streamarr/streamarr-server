# Preserve vendored notice text; notices/sources.json records its checksums.
buildpacks/ffmpeg/notices/** -whitespace
buildpacks/ffmpeg/generated/** linguist-generated=true
buildpacks/ffmpeg/generated/THIRD-PARTY-NOTICES.txt -whitespace conflict-marker-size=32
# These upstream Markdown headings contain seven equals signs.
buildpacks/ffmpeg/notices/chromaprint/LICENSE.md conflict-marker-size=32
buildpacks/ffmpeg/notices/openssl/AUTHORS.md conflict-marker-size=32

{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "always-update": true,
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "packages": {
    ".": {
      "release-type": "maven",
      "draft": true,
      "force-tag-creation": true,
      "pull-request-header": "Updates the Maven version and release notes.",
      "pull-request-footer": "Publishing uses the version and revision recorded in this pull request.",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "include-commit-authors": false,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "build", "section": "Build" },
        { "type": "revert", "section": "Reverts" },
        { "type": "behavioral", "section": "Changes" },
        { "type": "structural", "section": "Refactoring" }
      ]
    }
  }
}

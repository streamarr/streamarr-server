          },
          "status": {
            "type": "string"
          },
          "userCode": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "DeviceCodeRequest": {
        "properties": {
          "deviceName": {
            "type": "string"
          },
          "esn": {
            "type": "string"
          }
        },
        "type": "object"
      },

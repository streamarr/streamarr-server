#!/bin/bash
# shellcheck source-path=SCRIPTDIR

set -euo pipefail

layers_dir="${CNB_LAYERS_DIR:?CNB_LAYERS_DIR is required}"
target_arch="${CNB_TARGET_ARCH:?CNB_TARGET_ARCH is required}"
buildpack_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock_file="${buildpack_dir}/ffmpeg.lock"

# shellcheck source=../lib/http.sh
. "${buildpack_dir}/lib/http.sh"
# shellcheck source=../lib/lock.sh
. "${buildpack_dir}/lib/lock.sh"

download() {
  local url="$1"
  local destination="$2"
  local arguments=(
    --fail
    --location
    --proto '=https'
    --proto-redir '=https'
    --retry 3
    --silent
    --show-error
  )
  ffmpeg_curl "${arguments[@]}" "${url}" --output "${destination}"
}

ffmpeg_lock_validate "${lock_file}"
release="$(ffmpeg_lock_value "${lock_file}" release)"
version="$(ffmpeg_lock_value "${lock_file}" version)"
source_revision="$(ffmpeg_lock_value "${lock_file}" source_revision)"

case "${target_arch}" in
  amd64 | x86_64)
    asset="$(ffmpeg_lock_value "${lock_file}" amd64_asset)"
    checksum="$(ffmpeg_lock_value "${lock_file}" amd64_sha256)"
    ;;
  arm64 | aarch64)
    asset="$(ffmpeg_lock_value "${lock_file}" arm64_asset)"
    checksum="$(ffmpeg_lock_value "${lock_file}" arm64_sha256)"
    ;;
  *)
    echo "Unsupported FFmpeg target architecture: ${target_arch}" >&2
    exit 1
    ;;
esac

download_url="https://github.com/jellyfin/jellyfin-ffmpeg/releases/download/${release}/${asset}"
layer="${layers_dir}/ffmpeg"
layer_metadata="${layers_dir}/ffmpeg.toml"
cache_key="${release}/${asset}/${checksum}"

if [[ ! -x "${layer}/bin/ffmpeg" ]] || ! grep -Fq "cache_key = \"${cache_key}\"" "${layer_metadata}" 2>/dev/null; then
  rm -rf "${layer}"
  mkdir -p "${layer}/bin"

  download_dir="$(mktemp -d)"
  trap 'rm -rf "${download_dir}"' EXIT
  archive="${download_dir}/${asset}"

  download "${download_url}" "${archive}"
  printf '%s  %s\n' "${checksum}" "${archive}" | sha256sum --check --strict

  tar \
    --extract \
    --xz \
    --file "${archive}" \
    --directory "${layer}/bin" \
    ffmpeg ffprobe
fi

rm -rf "${layer}/env.launch"

version_output="$("${layer}/bin/ffmpeg" -version 2>&1)"
expected_runtime_version="${version%-*}-Jellyfin"
version_line="$(grep -F "ffmpeg version ${expected_runtime_version} " <<<"${version_output}" || true)"
version_line="${version_line%%$'\n'*}"
if [[ "${version_line}" != "ffmpeg version ${expected_runtime_version} "* ]]; then
  echo "Expected Jellyfin FFmpeg runtime version ${expected_runtime_version}" >&2
  exit 1
fi
runtime_version="${version_line#ffmpeg version }"
runtime_version="${runtime_version%% *}"
grep -F -- "--enable-gpl" <<<"${version_output}" >/dev/null
if grep -Fq -- "--enable-nonfree" <<<"${version_output}"; then
  echo "FFmpeg must not include nonfree components" >&2
  exit 1
fi
"${layer}/bin/ffmpeg" -hide_banner -h muxer=hls 2>&1 \
  | grep -F -- "-hls_segment_options" >/dev/null

cp "${buildpack_dir}/LICENSE.txt" "${layer}/LICENSE.txt"

printf '%s\n' \
  "FFmpeg ${runtime_version}" \
  "Binary release: https://github.com/jellyfin/jellyfin-ffmpeg/releases/tag/${release}" \
  "Build and FFmpeg source: https://github.com/jellyfin/jellyfin-ffmpeg/tree/${source_revision}" \
  >"${layer}/SOURCE.txt"

cat >"${layer_metadata}" <<EOF
[types]
launch = true
cache = true

[metadata]
cache_key = "${cache_key}"
version = "${version}"
release = "${release}"
source_revision = "${source_revision}"
EOF

cat >"${layers_dir}/ffmpeg.sbom.cdx.json" <<EOF
{
  "bomFormat": "CycloneDX",
  "specVersion": "1.6",
  "version": 1,
  "components": [
    {
      "type": "application",
      "bom-ref": "pkg:github/jellyfin/jellyfin-ffmpeg@${release}",
      "name": "FFmpeg",
      "version": "${version}",
      "publisher": "Jellyfin",
      "hashes": [
        {
          "alg": "SHA-256",
          "content": "${checksum}"
        }
      ],
      "licenses": [
        {
          "license": {
            "id": "GPL-3.0-or-later"
          }
        }
      ],
      "purl": "pkg:github/jellyfin/jellyfin-ffmpeg@${release}",
      "externalReferences": [
        {
          "type": "distribution",
          "url": "${download_url}"
        },
        {
          "type": "vcs",
          "url": "https://github.com/jellyfin/jellyfin-ffmpeg/commit/${source_revision}"
        }
      ]
    }
  ]
}
EOF

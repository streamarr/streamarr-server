#!/bin/bash

set -euo pipefail

layers_dir="${CNB_LAYERS_DIR:?CNB_LAYERS_DIR is required}"
target_arch="${CNB_TARGET_ARCH:?CNB_TARGET_ARCH is required}"
buildpack_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock_file="${buildpack_dir}/ffmpeg.lock"

lock_value() {
  local key="$1"
  local value
  value="$(sed -n "s/^${key}=//p" "${lock_file}")"
  if [[ -z "${value}" || "${value}" == *$'\n'* ]]; then
    echo "Expected exactly one ${key} entry in ${lock_file}" >&2
    exit 1
  fi
  printf '%s' "${value}"
}

release="$(lock_value release)"
version="$(lock_value version)"
source_revision="$(lock_value source_revision)"

case "${target_arch}" in
  amd64 | x86_64)
    platform=linux64
    asset="$(lock_value amd64_asset)"
    checksum="$(lock_value amd64_sha256)"
    ;;
  arm64 | aarch64)
    platform=linuxarm64
    asset="$(lock_value arm64_asset)"
    checksum="$(lock_value arm64_sha256)"
    ;;
  *)
    echo "Unsupported FFmpeg target architecture: ${target_arch}" >&2
    exit 1
    ;;
esac

expected_asset="ffmpeg-${version}-${platform}-gpl-8.1.tar.xz"
if [[ "${asset}" != "${expected_asset}" ]]; then
  echo "FFmpeg lock asset does not match pinned version ${version} for ${platform}" >&2
  exit 1
fi

download_url="https://github.com/BtbN/FFmpeg-Builds/releases/download/${release}/${asset}"
layer="${layers_dir}/ffmpeg"
layer_metadata="${layers_dir}/ffmpeg.toml"
cache_key="${release}/${asset}/${checksum}"

if [[ ! -x "${layer}/bin/ffmpeg" ]] || ! grep -Fq "cache_key = \"${cache_key}\"" "${layer_metadata}" 2>/dev/null; then
  rm -rf "${layer}"
  mkdir -p "${layer}"

  download_dir="$(mktemp -d)"
  trap 'rm -rf "${download_dir}"' EXIT
  archive="${download_dir}/${asset}"

  curl \
    --fail \
    --location \
    --proto '=https' \
    --proto-redir '=https' \
    --retry 3 \
    --retry-all-errors \
    --silent \
    --show-error \
    "${download_url}" \
    --output "${archive}"
  printf '%s  %s\n' "${checksum}" "${archive}" | sha256sum --check --strict

  tar \
    --extract \
    --xz \
    --file "${archive}" \
    --directory "${layer}" \
    --strip-components=1 \
    "ffmpeg-${version}-${platform}-gpl-8.1/bin/ffmpeg" \
    "ffmpeg-${version}-${platform}-gpl-8.1/bin/ffprobe" \
    "ffmpeg-${version}-${platform}-gpl-8.1/LICENSE.txt"
fi

rm -rf "${layer}/env.launch"

version_output="$("${layer}/bin/ffmpeg" -version 2>&1)"
version_line="${version_output%%$'\n'*}"
if [[ "${version_line}" != "ffmpeg version ${version}-"* ]]; then
  echo "Expected FFmpeg runtime version ${version} with an eight-digit build suffix" >&2
  exit 1
fi
runtime_version="${version_line#ffmpeg version }"
runtime_version="${runtime_version%% *}"
runtime_build_date="${runtime_version#"${version}-"}"
if [[ ! "${runtime_build_date}" =~ ^[0-9]{8}$ ]]; then
  echo "Expected FFmpeg runtime version ${version} with an eight-digit build suffix" >&2
  exit 1
fi
grep -F -- "--enable-gpl" <<<"${version_output}" >/dev/null
grep -F -- "--disable-libfdk-aac" <<<"${version_output}" >/dev/null
if grep -Fq -- "--enable-nonfree" <<<"${version_output}"; then
  echo "FFmpeg must not include nonfree components" >&2
  exit 1
fi
"${layer}/bin/ffmpeg" -hide_banner -h muxer=hls 2>&1 \
  | grep -F -- "-hls_segment_options" >/dev/null

printf '%s\n' \
  "FFmpeg ${runtime_version}" \
  "Binary release: https://github.com/BtbN/FFmpeg-Builds/releases/tag/${release}" \
  "Build source: https://github.com/BtbN/FFmpeg-Builds/tree/${release}" \
  "FFmpeg source: https://github.com/FFmpeg/FFmpeg/commit/${source_revision}" \
  >"${layer}/SOURCE.txt"

cat >"${layer_metadata}" <<EOF
[types]
launch = true
cache = true

[metadata]
cache_key = "${cache_key}"
version = "${version}"
release = "${release}"
source_revision = "${source_revision}"
EOF

cat >"${layers_dir}/ffmpeg.sbom.cdx.json" <<EOF
{
  "bomFormat": "CycloneDX",
  "specVersion": "1.6",
  "version": 1,
  "components": [
    {
      "type": "application",
      "bom-ref": "pkg:generic/ffmpeg@${version}",
      "name": "FFmpeg",
      "version": "${version}",
      "publisher": "BtbN/FFmpeg-Builds",
      "hashes": [
        {
          "alg": "SHA-256",
          "content": "${checksum}"
        }
      ],
      "licenses": [
        {
          "license": {
            "id": "GPL-3.0-or-later"
          }
        }
      ],
      "purl": "pkg:generic/ffmpeg@${version}",
      "externalReferences": [
        {
          "type": "distribution",
          "url": "${download_url}"
        },
        {
          "type": "vcs",
          "url": "https://github.com/FFmpeg/FFmpeg/commit/${source_revision}"
        }
      ]
    }
  ]
}
EOF

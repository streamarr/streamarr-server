#!/bin/bash
# shellcheck source-path=SCRIPTDIR

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd "${script_dir}/../../.." && pwd)"
# shellcheck source=../lib/http.sh
. "${script_dir}/../lib/http.sh"
# shellcheck source=../lib/lock.sh
. "${script_dir}/../lib/lock.sh"
# shellcheck source=../lib/notices.sh
. "${script_dir}/../lib/notices.sh"
# shellcheck source=../lib/materials.sh
. "${script_dir}/../lib/materials.sh"
check_only=false
verify_upstream=false
requested_release=
requested_release_set=false
requested_release_file=

usage() {
  echo "Usage: $0 [--check | --verify-upstream] [--release TAG | --release-file PATH] [--root REPOSITORY]" >&2
  exit 2
}

while (( $# > 0 )); do
  case "$1" in
    --check)
      check_only=true
      shift
      ;;
    --verify-upstream)
      verify_upstream=true
      shift
      ;;
    --release)
      (( $# >= 2 )) || usage
      requested_release="$2"
      requested_release_set=true
      shift 2
      ;;
    --release-file)
      (( $# >= 2 )) || usage
      requested_release_file="$2"
      shift 2
      ;;
    --root)
      (( $# >= 2 )) || usage
      repository_root="$(cd "$2" && pwd)"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done
if [[ "${check_only}" == true && "${verify_upstream}" == true ]]; then
  usage
fi
if [[ "${requested_release_set}" == true && -n "${requested_release_file}" ]]; then
  usage
fi

release_file="${repository_root}/buildpacks/ffmpeg/release"
if [[ -n "${requested_release_file}" ]]; then
  release_file="${requested_release_file}"
fi
lock_file="${repository_root}/buildpacks/ffmpeg/ffmpeg.lock"
if [[ "${verify_upstream}" == true ]]; then
  ffmpeg_lock_validate "${lock_file}"
fi
release="${requested_release}"
if [[ "${requested_release_set}" == false ]]; then
  release_lines=()
  while IFS= read -r line || [[ -n "${line}" ]]; do
    release_lines+=("${line}")
  done <"${release_file}"
  if (( ${#release_lines[@]} != 1 )); then
    echo "Expected ${release_file} to contain exactly one Jellyfin release tag" >&2
    exit 1
  fi
  release="${release_lines[0]}"
fi
if [[ ! "${release}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-[0-9]+$ ]]; then
  echo "Expected an exact Jellyfin release tag, found: ${release}" >&2
  exit 1
fi

if [[ "${check_only}" == true ]]; then
  ffmpeg_lock_validate "${lock_file}"
  ffmpeg_notices_validate "${lock_file}" "${repository_root}/buildpacks/ffmpeg"
  locked_release="$(ffmpeg_lock_value "${lock_file}" release)"
  if [[ "${locked_release}" == "${release}" ]]; then
    ffmpeg_materials_validate "${repository_root}/buildpacks/ffmpeg"
    exit 0
  fi
  echo "FFmpeg lock is stale; run buildpacks/ffmpeg/bin/update-lock" >&2
  exit 1
fi

download() {
  local url="$1"
  local destination="$2"
  local arguments=(
    --fail
    --location
    --proto '=https'
    --proto-redir '=https'
    --retry 3
    --silent
    --show-error
    --header 'Accept: application/vnd.github+json'
    --header 'X-GitHub-Api-Version: 2022-11-28'
    --user-agent 'streamarr-ffmpeg-lock-updater'
  )
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    arguments+=(--header "Authorization: Bearer ${GITHUB_TOKEN}")
  fi
  ffmpeg_curl "${arguments[@]}" "${url}" --output "${destination}"
}

temporary_directory="$(mktemp -d)"
trap 'rm -rf "${temporary_directory}"' EXIT
release_json="${temporary_directory}/release.json"
commit_json="${temporary_directory}/commit.json"

download \
  "https://api.github.com/repos/jellyfin/jellyfin-ffmpeg/releases/tags/${release}" \
  "${release_json}"

if ! jq -e --arg release "${release}" \
  '.tag_name == $release and .draft == false and .prerelease == false' \
  "${release_json}" >/dev/null; then
  echo "Expected a published, non-prerelease Jellyfin release for ${release}" >&2
  exit 1
fi

version="${release#v}"
asset_variant=gpl
amd64_asset="jellyfin-ffmpeg_${version}_portable_linux64-${asset_variant}.tar.xz"
arm64_asset="jellyfin-ffmpeg_${version}_portable_linuxarm64-${asset_variant}.tar.xz"

asset_digest() {
  local name="$1"
  local digest
  if [[ "$(jq --arg name "${name}" '[.assets[] | select(.name == $name)] | length' "${release_json}")" != 1 ]]; then
    echo "Expected exactly one ${name} release asset" >&2
    return 1
  fi
  digest="$(jq -r --arg name "${name}" '.assets[] | select(.name == $name) | .digest' "${release_json}")"
  if [[ ! "${digest}" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "Expected ${name} to have a SHA-256 GitHub asset digest" >&2
    return 1
  fi
  printf '%s' "${digest#sha256:}"
}

amd64_sha256="$(asset_digest "${amd64_asset}")"
arm64_sha256="$(asset_digest "${arm64_asset}")"
download "https://api.github.com/repos/jellyfin/jellyfin-ffmpeg/commits/${release}" "${commit_json}"
source_revision="$(jq -r '.sha' "${commit_json}")"
if [[ ! "${source_revision}" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Expected ${release} to resolve to a full Jellyfin FFmpeg source revision" >&2
  exit 1
fi

temporary_lock="$(mktemp "${lock_file}.tmp.XXXXXX")"
trap 'rm -rf "${temporary_directory}"; rm -f "${temporary_lock}"' EXIT
for key in "${ffmpeg_lock_keys[@]}"; do
  printf '%s=%s\n' "${key}" "${!key}"
done >"${temporary_lock}"

if [[ "${verify_upstream}" == true ]]; then
  if cmp -s "${temporary_lock}" "${lock_file}"; then
    exit 0
  fi
  echo "FFmpeg lock does not match canonical upstream metadata" >&2
  diff -u "${lock_file}" "${temporary_lock}" || true
  exit 1
fi

mv "${temporary_lock}" "${lock_file}"

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "schedule:earlyMondays"
  ],
  "labels": ["dependencies"],
  "gitIgnoredAuthors": ["streamarr-ffmpeg-lock[bot]@users.noreply.github.com"],
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Pack builder used by container-image workflows",
      "managerFilePatterns": ["/^\\.github/actions/pack-build/action\\.yml$/"],
      "matchStrings": [
        "--builder (?<depName>paketobuildpacks/ubuntu-noble-builder):(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update pinned Paketo buildpacks used by container-image workflows",
      "managerFilePatterns": ["/^\\.github/actions/pack-build/action\\.yml$/"],
      "matchStrings": [
        "--buildpack (?<depName>paketo-buildpacks/procfile)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "buildpacks-registry",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track pinned BtbN FFmpeg runtime releases",
      "managerFilePatterns": [
        "/^buildpacks/ffmpeg/release$/"
      ],
      "matchStrings": [
        "(?<currentValue>autobuild-\\d{4}-\\d{2}-\\d{2}-\\d{2}-\\d{2})"
      ],
      "depNameTemplate": "BtbN/FFmpeg-Builds",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^autobuild-(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})-(?<build>\\d{2})-(?<revision>\\d{2})$"
    }
  ],
  "packageRules": [
    {
      "description": "Group patch updates and automerge when CI passes",
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "patch dependencies",
      "automerge": true
    },
    {
      "description": "Group minor updates into a single PR",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor dependencies"
    },
    {
      "description": "Keep FFmpeg runtime updates isolated for lock synchronization",
      "matchDepNames": ["BtbN/FFmpeg-Builds"],
      "groupName": "FFmpeg runtime",
      "automerge": false
    }
  ],
  "prConcurrentLimit": 10
}

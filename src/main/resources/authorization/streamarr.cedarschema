// Streamarr authorization schema (ADR 0025). Entity attributes are facts the slice builders load;
// optional attributes are present only for actions whose builders load them, so a policy that needs
// a fact must test `has` before reading it — an absent fact reads as "not proven", never as "true".
namespace Streamarr {
  // The authenticated Account. Signed facts (membership Household, role, context Household,
  // selected Profile) come from the token; live facts (enabled, serverAdmin, session liveness,
  // whether the context Household may still be used) are read from PostgreSQL per action.
  entity Account {
    enabled?: Bool,
    serverAdmin?: Bool,
    householdRole?: String,
    membershipHousehold?: Household,
    contextHousehold?: Household,
    selectedProfile?: Profile,
    contextHouseholdUsable?: Bool,
    sessionLive?: Bool,
    liveHouseholdRole?: String,
    liveMembershipHousehold?: Household,
  };

  entity Household;

  // A Profile as seen from the principal's vantage point for one decision.
  entity Profile {
    availableInContext?: Bool,
    locked?: Bool,
    pinRequired?: Bool,
    managedByPrincipal?: Bool,
    availableInPrincipalHousehold?: Bool,
  };

  // The singleton root resource server-wide authority is granted on.
  entity Server;

  action serverAdministration;
  action libraryAdministration in serverAdministration;
  action householdAdministration;
  action accountAdministration;
  action profileAdministration;

  action addLibrary in libraryAdministration appliesTo {
    principal: Account,
    resource: Server,
    context: {},
  };
  action removeLibrary in libraryAdministration appliesTo {
    principal: Account,
    resource: Server,
    context: {},
  };
  action scanLibrary in libraryAdministration appliesTo {
    principal: Account,
    resource: Server,
    context: {},
  };
  action refreshLibrary in libraryAdministration appliesTo {
    principal: Account,
    resource: Server,
    context: {},
  };

  action viewProfilePicker appliesTo {
    principal: Account,
    resource: Household,
    context: {},
  };
  action selectProfile appliesTo {
    principal: Account,
    resource: Profile,
    context: { pinVerified: Bool },
  };
  action playback appliesTo {
    principal: Account,
    resource: Profile,
    context: {},
  };
  action viewProfileActivity appliesTo {
    principal: Account,
    resource: Profile,
    context: {},
  };
  action viewHouseholdAdministration in householdAdministration appliesTo {
    principal: Account,
    resource: Household,
    context: {},
  };
  action viewAccountAdministration in accountAdministration appliesTo {
    principal: Account,
    resource: Account,
    context: {},
  };
  action grantServerAdmin in accountAdministration appliesTo {
    principal: Account,
    resource: Account,
    context: { freshReauthentication: Bool },
  };
  action revokeServerAdmin in accountAdministration appliesTo {
    principal: Account,
    resource: Account,
    context: { freshReauthentication: Bool },
  };
  action grantHouseholdAdmin in accountAdministration appliesTo {
    principal: Account,
    resource: Account,
    context: {},
  };
  action revokeHouseholdAdmin in accountAdministration appliesTo {
    principal: Account,
    resource: Account,
    context: {},
  };
  action disableAccount in accountAdministration appliesTo {
    principal: Account,
    resource: Account,
    context: {},
  };
  action enableAccount in accountAdministration appliesTo {
    principal: Account,
    resource: Account,
    context: {},
  };
  action renameAccount in accountAdministration appliesTo {
    principal: Account,
    resource: Account,
    context: {},
  };
  action createHousehold in householdAdministration appliesTo {
    principal: Account,
    resource: Server,
    context: {},
  };
  action renameHousehold in householdAdministration appliesTo {
    principal: Account,
    resource: Household,
    context: {},
  };
  action viewProfileAdministration in profileAdministration appliesTo {
    principal: Account,
    resource: Profile,
    context: {},
  };
}

type StreamSession {
    id: ID!
    streamUrl: String!
    transcodeMode: TranscodeMode!
}

enum TranscodeMode {
    REMUX
    AUDIO_TRANSCODE
    VIDEO_TRANSCODE
    FULL_TRANSCODE
}

"The viewer's playback choices. What the client can play belongs in the client capability declaration."
input StreamingOptionsInput {
    quality: VideoQuality
    maxWidth: Int
    maxHeight: Int
    maxBitrate: Int
    audioLanguage: String
    subtitleLanguage: String
}

enum VideoQuality {
    AUTO
    ORIGINAL
    LOW_360P
    MEDIUM_480P
    HIGH_720P
    FULL_HD_1080P
    UHD_4K
}

enum PlaybackState {
    PLAYING
    PAUSED
    STOPPED
}

enum WatchStatus {
    UNWATCHED
    IN_PROGRESS
    WATCHED
}

type WatchProgress {
    positionSeconds: Int!
    percentComplete: Float!
    durationSeconds: Int!
}

union ContinueWatchingMedia = Movie | Episode

"A page of the selected Profile's Continue Watching list."
type ContinueWatchingConnection {
    edges: [ContinueWatchingEdge]!
    pageInfo: PageInfo!
}

"Membership and ordering in Continue Watching, shared by queries and change payloads."
type ContinueWatchingEdge implements OrderedEdge {
    node: ContinueWatchingMedia
    cursor: String!
    "Compare as ascending ASCII strings; includes last-watched descending and the ID tie-breaker."
    orderKey: String!
}

"An item whose watch state a Profile can change."
union WatchStateItem = Movie | Episode | Season | Series

input MarkWatchedInput {
    "The ID of a movie, episode, season or series."
    itemId: ID!
}

type MarkWatchedPayload {
    "The marked item in its resulting state. The item is null when userErrors is not empty."
    item: WatchStateItem
    userErrors: [MarkWatchedError!]!
}

union MarkWatchedError = InvalidIdError | ItemNotFoundError

input MarkUnwatchedInput {
    "The ID of a movie, episode, season or series."
    itemId: ID!
}

type MarkUnwatchedPayload {
    "The marked item in its resulting state. The item is null when userErrors is not empty."
    item: WatchStateItem
    userErrors: [MarkUnwatchedError!]!
}

union MarkUnwatchedError = InvalidIdError | ItemNotFoundError

"""
One format attempt's delivery of the media to the player. The server chooses the delivery (ADR 0013):
HLS, or direct play of the source file (ADR 0045).
"""
interface StreamSession {
    id: ID!
    "The URL that the player opens. It carries the playback token."
    streamUrl: String!
    """
    Where playback of this stream session starts, in seconds from the start of the media. Null when
    playback starts at the beginning of the media.
    """
    startPositionSeconds: Float
}

"""
A stream session that sends the source file itself. The player reads the file at streamUrl with HTTP
byte-range requests. The server chooses direct play only in Original, for a file that the capability
declaration covers.
"""
type DirectPlayStreamSession implements StreamSession {
    id: ID!
    "The URL of the source file. It carries the playback token."
    streamUrl: String!
    "The source container of the file, which also names the URL's extension and media type."
    sourceContainer: SourceContainer!
    "The dynamic range of the source's video."
    videoRange: VideoRange!
    """
    Where playback starts, in seconds from the start of the media. The client seeks the file there before
    playback starts. Null when playback starts at the beginning of the media.
    """
    startPositionSeconds: Float
    """
    The audio track that a player that selects audio tracks selects after it opens the file (ADR 0045): its
    position, counting from 0, among the file's audio tracks in stream order, which is the order of the
    player's own audio track list. It is the track that HLS plays for the same file. A player that cannot
    select audio tracks direct-plays only when it is 0 and that track is the one it starts on. Null when the
    file has no audio track.
    """
    audioTrackPosition: Int
    """
    The file's audio tracks in stream order, so that a player that cannot list them offers them (ADR 0045).
    Empty when the file has no audio track.
    """
    audioTracks: [AudioTrack!]!
}

"One audio track of a source file, as the probe found it."
type AudioTrack {
    "Its position, counting from 0, among the file's audio tracks in stream order, as audioTrackPosition counts."
    position: Int!
    "The language that the file tags the track with, as the file spells it, such as eng. Null when the file tags none."
    language: String
    "The title that the file gives the track. Null when the file gives none."
    title: String
}

"A stream session that sends HLS, from job attempts that copy or encode the source."
type HlsStreamSession implements StreamSession {
    id: ID!
    "The URL of the multivariant playlist. It carries the playback token."
    streamUrl: String!
    transcodeMode: TranscodeMode!
    "The dynamic range of the stream session's video. Every variant of a stream session shares it."
    videoRange: VideoRange!
    """
    Seconds on the media timeline that the segment grid uses, where the media really ends, when a stream
    copy ran short of its playlist's advertised end after every source stream ended (ADR 0052). The client
    ends playback at this time, as at the end of the media title, and requests no segment past it. The server
    holds a segment request past it until the client ends playback or the stream session ends, and answers
    every format failure report for the stream session with this end. Null while nothing shows that the
    media ends before the advertised end.
    """
    mediaEndSeconds: Float
    """
    Where playback starts, in seconds from the start of the media. The multivariant playlist marks the
    same position with EXT-X-START and PRECISE=YES. Null when playback starts at the beginning of the
    media.
    """
    startPositionSeconds: Float
}

"The dynamic range of a stream session's video, as an HLS playlist's VIDEO-RANGE attribute names it."
enum VideoRange {
    SDR
    "SMPTE ST 2084, which covers HDR10, PQ10 and the PQ base of Dolby Vision."
    PQ
    "Hybrid log-gamma, ARIB STD-B67."
    HLG
}

enum TranscodeMode {
    REMUX
    AUDIO_TRANSCODE
    VIDEO_TRANSCODE
    FULL_TRANSCODE
}

"The viewer's playback choices. What the client can play belongs in the client capability declaration."
input StreamingOptionsInput {
    quality: VideoQuality
    maxWidth: Int
    maxHeight: Int
    maxBitrate: Int
    "The audio language of this session. It wins over the Profile's language preferences and overrides."
    audioLanguage: Language
    "The subtitle language of this session. Stored now; subtitles apply when they ship."
    subtitleLanguage: Language
    """
    The viewer's HDR choice (ADR 0013). Only a fixed quality takes it: SDR plays an HDR source as an SDR encode,
    and HDR keeps the source's HDR range when the client declares it. Auto and Original ignore it. Null for no
    choice, which keeps the source's HDR range when the client declares it. The stream session's videoRange
    names the range that plays.
    """
    dynamicRange: DynamicRangeChoice
}

"The viewer's HDR choice in a fixed quality."
enum DynamicRangeChoice {
    "Keep the source's HDR range when the client declares it."
    HDR
    "Play an HDR source as an SDR encode."
    SDR
}

enum VideoQuality {
    AUTO
    ORIGINAL
    LOW_360P
    MEDIUM_480P
    HIGH_720P
    FULL_HD_1080P
    UHD_4K
}

enum PlaybackState {
    PLAYING
    PAUSED
    STOPPED
}

enum WatchStatus {
    UNWATCHED
    IN_PROGRESS
    WATCHED
}

type WatchProgress {
    positionSeconds: Int!
    percentComplete: Float!
    durationSeconds: Int!
}

union ContinueWatchingMedia = Movie | Episode

"A page of the selected Profile's Continue Watching list."
type ContinueWatchingConnection {
    edges: [ContinueWatchingEdge]!
    pageInfo: PageInfo!
}

"Membership and ordering in Continue Watching, shared by queries and change payloads."
type ContinueWatchingEdge implements OrderedEdge {
    node: ContinueWatchingMedia
    cursor: String!
    "Compare as ascending ASCII strings; includes last-watched descending and the ID tie-breaker."
    orderKey: String!
}

"An item whose watch state a Profile can change."
union WatchStateItem = Movie | Episode | Season | Series

input MarkWatchedInput {
    "The ID of a movie, episode, season or series."
    itemId: ID!
}

type MarkWatchedPayload {
    "The marked item in its resulting state. The item is null when userErrors is not empty."
    item: WatchStateItem
    userErrors: [MarkWatchedError!]!
}

union MarkWatchedError = InvalidIdError | ItemNotFoundError

input MarkUnwatchedInput {
    "The ID of a movie, episode, season or series."
    itemId: ID!
}

type MarkUnwatchedPayload {
    "The marked item in its resulting state. The item is null when userErrors is not empty."
    item: WatchStateItem
    userErrors: [MarkUnwatchedError!]!
}

union MarkUnwatchedError = InvalidIdError | ItemNotFoundError

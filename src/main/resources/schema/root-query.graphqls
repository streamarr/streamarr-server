type Query {
    playbackSession(id: ID!): PlaybackSession
    me: Me!
    movie(id: ID!): Movie
    series(id: ID!): Series
    season(id: ID!): Season
    episode(id: ID!): Episode
    rating(id: ID!): Rating!
    library(id: ID!): Library!
    libraries: [Library!]!
    """
    The selected Profile's Continue Watching list, newest last-watched first. Forward-only:
    first defaults to 20; after continues from an opaque cursor for this Profile and list.
    Authorizes from the signed selected-Profile token, including revalidation queries.
    """
    continueWatching(first: Int, after: String): ContinueWatchingConnection!
    """
    The signed-in Account's Notifications, newest latestEventAt first. Forward-only: first
    defaults to 20, and after continues from an opaque cursor for this Account and list. Needs an
    Account session that is not device-bound, with or without a selected Profile. A device-bound
    session gets FORBIDDEN.
    """
    notifications(first: Int, after: String): NotificationConnection!
    """
    How many of the signed-in Account's Notifications are unread, including the requests that
    still wait. The same access as notifications.
    """
    unreadNotificationCount: Int!
    householdAdministration(householdId: ID!): HouseholdAdministration
    households(first: Int, after: String, last: Int, before: String): HouseholdAdministrationConnection!
    accountAdministration(accountId: ID!): AccountAdministration
    """
    A Profile's administrative details: for its managers, for the HouseholdAdmins of a Household
    where it is available, and for ServerAdmins. Null for everyone else, for a device-bound session
    and when no Profile has the id.
    """
    profileAdministration(profileId: ID!): ProfileAdministration
    """
    A Household's Profiles for Household settings, by name. Its HouseholdAdmins and ServerAdmins
    get every Profile available there, both those that belong there and the visitors shared in,
    and also the Profiles they manage that belong there but are not available there. Any other
    Account gets the Profiles it manages that belong there; an Account whose own Personal Profile
    is supervised manages none, so its list is empty. A visitor's row never says where it comes
    from. A device-bound session and a disabled Account get an empty list.
    """
    householdProfiles(householdId: ID!, first: Int, after: String, last: Int, before: String): HouseholdProfileConnection!
    """
    Every Account invitation, newest first. ServerAdmin work: everyone else, a device-bound session
    included, gets FORBIDDEN.
    """
    accountInvitations(first: Int, after: String, last: Int, before: String): AccountInvitationConnection!
    """
    Before an Account is invited for an existing Profile: the Profile, the Household it belongs to
    and the other Households where it is available. ServerAdmin work: everyone else, a device-bound
    session included, gets FORBIDDEN. Null when no Profile has the id, when it is already an
    Account's Personal Profile, or when its Household no longer exists.
    """
    accountInvitationProfilePreview(profileId: ID!): AccountInvitationProfilePreview
    """
    What offering this Profile to the Household a share code names would mean: whether the Profile
    would lock there, and whether its name conflicts with a Profile already there. Nothing else
    about the Household. The code stays live. Each request is a credential attempt by the Account
    that presents the code, counted as lookUpShareCode counts it. Null when the code does not work,
    when the Profile does not exist, and when the caller may not offer it. A device-bound session
    and a disabled Account get FORBIDDEN.
    """
    profileSharePreview(profileId: ID!, shareCode: String!): ProfileSharePreview
    """
    The Profiles offered or shared to a Household, newest first, for its HouseholdAdmins and for
    ServerAdmins. Everyone else gets an empty list. The HouseholdAdmins get only the offers still
    waiting for a decision and the active shares: once an offer is declined, canceled, expired or
    withdrawn, or a share has ended, it leaves their list. ServerAdmins get every status.
    statuses keeps only shares in those statuses, and an offer past its expiry counts as EXPIRED.
    Leave statuses out, or pass an empty list, to get every share the reader may list. Pass
    [PENDING] for the offers waiting for a decision. visitorsOnly: true keeps
    only shares of visitors: Profiles that belong to another Household, so the Household's own
    Profiles are left out. Leave it out, or pass false, to get both. Pass visitorsOnly: true with
    [PENDING, ACTIVE] for the Profiles shared with the Household, or waiting for its decision.
    """
    householdShares(householdId: ID!, statuses: [ProfileShareStatus!], visitorsOnly: Boolean, first: Int, after: String, last: Int, before: String): ProfileShareConnection!
    """
    A Profile's shares into every Household, newest first, for its managers and ServerAdmins. The
    Account of a self-managed Personal Profile is one of its managers; the Account of a supervised
    Personal Profile is not. Everyone else gets an empty list, including a HouseholdAdmin where the
    Profile is available: householdShares gives them the share into their own Household.
    statuses keeps only shares in those statuses, as householdShares does: pass [PENDING, ACTIVE]
    for where the Profile is offered or available now.
    """
    profileShares(profileId: ID!, statuses: [ProfileShareStatus!], first: Int, after: String, last: Int, before: String): ProfileShareConnection!
    """
    A Household's live share codes, newest first, for its HouseholdAdmins and for ServerAdmins:
    who issued each and when it expires, never the code. A code leaves the list once it is spent,
    withdrawn, invalidated or past its expiry. Everyone else gets an empty list, and so does a
    device-bound session.
    """
    householdShareCodes(householdId: ID!, first: Int, after: String, last: Int, before: String): ShareCodeConnection!
    """
    A share code's current status and metadata, including after it leaves the live list; never
    the code itself. Only its Household's HouseholdAdmins and ServerAdmins may read it.
    A missing code, an unauthorized caller or a device-bound session gets null.
    """
    shareCode(shareCodeId: ID!): ShareCode
    """
    The pending invitations to manage a Profile, newest first, for its managers and for
    ServerAdmins. An invitation leaves the list once it is accepted, declined, canceled, replaced,
    invalidated or expired. Everyone else gets an empty list, a HouseholdAdmin who only supervises
    the Profile included, as do a device-bound session and a Profile that does not exist.
    """
    pendingManagerInvitationsForProfile(profileId: ID!, first: Int, after: String, last: Int, before: String): ManagerInvitationConnection!
    """
    Which Profiles giving this Profile the kind and content limit given would lock, before the
    change is made; maximumAllowedRatingAge null means no content limit, and a limit the change
    would refuse is previewed as given. For whoever may read profileAdministration of the Profile.
    Null for everyone else, for a device-bound session and when no Profile has the id. It lists
    only the Households whose Profile picker the asking Account may see.
    """
    profilePolicyChangePreview(profileId: ID!, kind: ProfileKind!, maximumAllowedRatingAge: Int): ProfileLockPreview
    """
    Which Profiles creating a Profile of this kind and content limit in the Household would lock
    there, and whether the new Profile itself would be locked until it has a PIN, before it is
    created; maximumAllowedRatingAge null means no content limit. For whoever may create a Profile
    there: its HouseholdAdmins whose own Personal Profile is an unrestricted Adult, and
    ServerAdmins. It lists the Household only when the asking Account may see its Profile picker,
    so a ServerAdmin who may not use the Household gets an empty list. Null for everyone else, for
    a device-bound session and when no Household has the id.
    """
    profileCreationPreview(householdId: ID!, kind: ProfileKind!, maximumAllowedRatingAge: Int): ProfileLockPreview
    """
    The Accounts that manage a Profile, for the Managers section of its page: the Account whose own
    Personal Profile it is first, then its direct managers by display name. Only the Profile's
    managers and ServerAdmins read it. Anyone else, a HouseholdAdmin who only supervises it among
    them, gets an empty list, as do a device-bound session, a disabled Account and a Profile that
    does not exist.
    """
    profileManagers(profileId: ID!, first: Int, after: String, last: Int, before: String): ProfileManagerConnection!
    """
    The pending invitations to manage a Profile that name the signed-in Account, newest first. Empty
    for a device-bound session and for a disabled Account.
    """
    pendingManagerInvitations(first: Int, after: String, last: Int, before: String): ManagerInvitationConnection!
    """
    A Household's active Devices, newest first, for its HouseholdAdmins and for ServerAdmins.
    Everyone else gets an empty list. visitorsOnly: true keeps only the Devices that visitors
    linked: people who are not members of the Household. Leave it out, or pass false, to get every
    Device.
    """
    householdDevices(householdId: ID!, visitorsOnly: Boolean, first: Int, after: String, last: Int, before: String): DeviceRegistrationConnection!
    esnBlocks(householdId: ID!, first: Int, after: String, last: Int, before: String): EsnBlockConnection!
    serverEsnBlocks(first: Int, after: String, last: Int, before: String): EsnBlockConnection!
    householdDeletionPreview(householdId: ID!): HouseholdDeletionPreview
    securityAuditEvents(first: Int, after: String, last: Int, before: String): SecurityAuditEventConnection!
    """
    A Profile's viewing activity, most recent first: for its managers, for a session whose selected
    Profile it is, and for ServerAdmins. Everyone else gets an empty list, as does a Profile that
    does not exist.
    """
    profileActivity(profileId: ID!, first: Int, after: String, last: Int, before: String): ProfileActivityConnection!
    encoderPresetSetting: EncoderPresetSetting!
    idleSegmentRetentionSetting: IdleSegmentRetentionSetting!
    "How long the server keeps read news and resolved requests. Requires a ServerAdmin."
    notificationRetentionSetting: NotificationRetentionSetting!
    "How long a share code stays live after it is issued. Requires a ServerAdmin."
    shareCodeLifetimeSetting: ShareCodeLifetimeSetting!
    "How long an invitation or an offer of a Profile waits for its answer. Requires a ServerAdmin."
    invitationLifetimeSetting: InvitationLifetimeSetting!
    "How many live share codes a Household may hold at once. Requires a ServerAdmin."
    shareCodeLimitSetting: ShareCodeLimitSetting!
}

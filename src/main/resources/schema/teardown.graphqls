# Household teardown, the security audit, and Profile activity (ADR 0024 §Teardown, §Audit).

enum LastAccountAction {
    "Transfer the Account and linked Profile pair to the destination Household."
    TRANSFER
    "Delete the Account and Profile pair."
    DELETE
    "Delete the Account and preserve its Profile with a manager in the destination Household."
    DELETE_ACCOUNT_KEEP_PROFILE
}

input LastAccountInput {
    choice: LastAccountAction!
    destinationHouseholdId: ID
    replacementManagerAccountId: ID
}

input TearDownHouseholdInput {
    householdId: ID!
    reason: String!
    "Required when exactly one Account remains; absent when none do."
    lastAccount: LastAccountInput
}

type TearDownHouseholdPayload {
    householdId: ID
    userErrors: [TearDownHouseholdError!]!
}

union TearDownHouseholdError =
    HouseholdNotFoundError
  | ReasonRequiredError
  | ReauthenticationRequiredError
  | AccountsRemainError
  | LastAccountActionRequiredError
  | LastAccountActionNotAllowedError
  | DestinationRequiredError
  | DestinationNotFoundError
  | ReplacementManagerRequiredError
  | AccountNotFoundError
  | ProfileManagerNotEligibleError
  | LastServerAdminError

type ProfileDeletionPreview {
    id: ID!
    name: String!
}

"What teardown will take with it; null for whoever may not view the Household."
type HouseholdTeardownPreview {
    accountCount: Int!
    profilesToDelete: [ProfileDeletionPreview!]!
    visitingProfileCount: Int!
}

type SecurityAuditEventDetails {
    id: ID!
    occurredAt: String!
    actorAccountId: ID
    operation: String!
    outcome: String!
    reason: String
    "The audited resource ids as stored JSON text."
    resources: String!
}

type SecurityAuditEventConnection {
    edges: [SecurityAuditEventEdge!]!
    pageInfo: PageInfo!
}

type SecurityAuditEventEdge {
    node: SecurityAuditEventDetails!
    cursor: String!
}

type ProfileActivityDetails {
    id: ID!
    mediaFileId: ID!
    positionSeconds: Int!
    percentComplete: Float!
    durationSeconds: Int!
    watchedAt: String!
}

type ProfileActivityConnection {
    edges: [ProfileActivityEdge!]!
    pageInfo: PageInfo!
}

type ProfileActivityEdge {
    node: ProfileActivityDetails!
    cursor: String!
}

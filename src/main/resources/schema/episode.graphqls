type Episode {
    id: ID!
    title: String
    episodeNumber: Int!
    overview: String
    airDate: String
    runtime: Int
    season: Season!
    files: [MediaFile]!
    images(type: ImageType): [Image]!
    "The selected Profile's state of this episode. Null when the request has no selected Profile."
    selectedProfileState: SelectedProfileState
}

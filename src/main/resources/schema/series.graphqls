type Series implements BaseCollectable {
    id: ID!
    createdBy: String
    createdOn: String!
    lastModifiedBy: String
    lastModifiedOn: String!
    title: String
    originalTitle: String
    titleSort: String
    tagline: String
    summary: String
    runtime: Int
    contentRating: ContentRating
    firstAirDate: String
    studios: [Company]!
    cast: [Person]!
    directors: [Person]!
    genres: [Genre]!
    seasons: [Season]!
    files: [MediaFile]!
    images(type: ImageType): [Image]!
    watchProgress: WatchProgress
    watchStatus: WatchStatus!
    """
    When the selected Profile last watched any episode of this series, as an ISO-8601 instant.
    The value is the latest lastWatchedAt among the episodes. The LAST_WATCHED sort orders series
    by this value. Null when the Profile has not watched any episode of this series.
    """
    lastWatchedAt: String
    "The library that holds this series."
    library: Library!
    """
    True when this series has no provider id, so no metadata provider matched it. Agrees with the
    unmatched filter on Library.items.
    """
    unmatched: Boolean!
}

type Series implements BaseCollectable {
    id: ID!
    createdBy: String
    createdOn: String!
    lastModifiedBy: String
    lastModifiedOn: String!
    title: String
    originalTitle: String
    titleSort: String
    tagline: String
    summary: String
    runtime: Int
    contentRating: ContentRating
    firstAirDate: String
    studios: [Company]!
    cast: [Person]!
    directors: [Person]!
    genres: [Genre]!
    "Seasons containing at least one episode with an associated media file, in season-number order."
    seasons: [Season]!
    files: [MediaFile]!
    images(type: ImageType): [Image]!
    "The selected Profile's state of this series. Null when the request has no selected Profile."
    selectedProfileState: SelectedProfileState
    "The library that holds this series."
    library: Library!
    """
    True when this series has no provider id, so no metadata provider matched it. Agrees with the
    unmatched filter on Library.items.
    """
    unmatched: Boolean!
}

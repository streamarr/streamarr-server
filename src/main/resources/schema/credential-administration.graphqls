# Account invitations and password recovery (ADR 0024 §Invitations, §Account; ADR 0026 shapes).
# Codes are returned exactly once at issuance and are never queryable again.

enum AccountInvitationStatus {
    PENDING
    ACCEPTED
    DECLINED
    CANCELED
    EXPIRED
    INVALIDATED
}

type AccountInvitationDetails {
    id: ID!
    recipientEmail: String!
    "Null once the target Household is deleted; the invitation is then INVALIDATED."
    householdId: ID
    householdName: String!
    householdRole: HouseholdRole!
    profile: AccountInvitationProfile!
    status: AccountInvitationStatus!
    expiresAt: String!
}

union AccountInvitationProfile =
    NewAccountInvitationProfile
  | ExistingAccountInvitationProfile

type NewAccountInvitationProfile {
    name: String!
    kind: ProfileKind!
    maximumAllowedRatingAge: Int
}

type ExistingAccountInvitationProfile {
    id: ID!
    name: String!
    kind: ProfileKind!
    maximumAllowedRatingAge: Int
}

type AccountInvitationConnection {
    edges: [AccountInvitationEdge!]!
    pageInfo: PageInfo!
}

type AccountInvitationEdge {
    node: AccountInvitationDetails!
    cursor: String!
}

type AccountInvitationProfilePreview {
    profileId: ID!
    profileName: String!
    householdId: ID!
    householdName: String!
    affectedHouseholds: [AccountInvitationAffectedHousehold!]!
}

type AccountInvitationAffectedHousehold {
    householdId: ID!
    householdName: String!
}

input IssueAccountInvitationWithNewProfileInput {
    recipientEmail: String!
    householdId: ID!
    householdRole: HouseholdRole!
    profileName: String!
    profileKind: ProfileKind!
    maximumAllowedRatingAge: Int
    "Required when the Profile is restricted."
    profileManagerAccountId: ID
}

input IssueAccountInvitationForExistingProfileInput {
    recipientEmail: String!
    profileId: ID!
    householdRole: HouseholdRole!
    "Households where the Profile should be offered again after the recipient accepts."
    reofferHouseholdIds: [ID!]!
}

"The code appears here once and never again."
type IssuedAccountInvitation {
    invitation: AccountInvitationDetails!
    code: String!
}

type IssueAccountInvitationWithNewProfilePayload {
    issued: IssuedAccountInvitation
    userErrors: [IssueAccountInvitationWithNewProfileError!]!
}

union IssueAccountInvitationWithNewProfileError =
    EmailRequiredError
  | EmailInvalidError
  | EmailAlreadyUsedError
  | ProfileNameRequiredError
  | ProfileNameTakenError
  | HouseholdNotFoundError
  | RestrictedFirstAccountError
  | RestrictedHouseholdAdminError
  | EligibleProfileManagerRequiredError
  | MaximumAllowedRatingAgeInvalidError
  | ProfileManagerNotEligibleError

type IssueAccountInvitationForExistingProfilePayload {
    issued: IssuedAccountInvitation
    userErrors: [IssueAccountInvitationForExistingProfileError!]!
}

union IssueAccountInvitationForExistingProfileError =
    EmailRequiredError
  | EmailInvalidError
  | EmailAlreadyUsedError
  | HouseholdNotFoundError
  | LinkProfileNotFoundError
  | ProfileAlreadyLinkedError
  | ReofferHouseholdNotFoundError
  | ReofferHouseholdNotSharedError

input CancelAccountInvitationInput {
    invitationId: ID!
}

type CancelAccountInvitationPayload {
    invitation: AccountInvitationDetails
    userErrors: [CancelAccountInvitationError!]!
}

union CancelAccountInvitationError = InvitationNotPendingError

input IssuePasswordResetInput {
    accountId: ID!
    reason: String!
}

"The code appears here once and never again."
type IssuedPasswordReset {
    accountId: ID!
    code: String!
    expiresAt: String!
}

type IssuePasswordResetPayload {
    issued: IssuedPasswordReset
    userErrors: [IssuePasswordResetError!]!
}

union IssuePasswordResetError =
    AccountNotFoundError
  | ReasonRequiredError
  | ReauthenticationRequiredError

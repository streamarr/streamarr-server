type Movie implements BaseCollectable {
    id: ID!
    createdBy: String
    createdOn: String!
    lastModifiedBy: String
    lastModifiedOn: String!
    title: String
    originalTitle: String
    titleSort: String
    tagline: String
    summary: String
    runtime: Int
    releaseDate: String
    contentRating: ContentRating
    files: [MediaFile]!
    studios: [Company]!
    cast: [Person]!
    directors: [Person]!
    genres: [Genre]!
    ratings: [Rating]!
    reviews: [Review]!
    images(type: ImageType): [Image]!
    watchProgress: WatchProgress
    watchStatus: WatchStatus!
    """
    When the selected Profile last watched this movie, as an ISO-8601 instant. It is the later of
    the latest completion or manual mark that has not been dismissed and the latest session
    progress with a position. Progress older than that completion does not count. The
    LAST_WATCHED sort orders movies by this value. Continue Watching orders by this value, newest
    first, then by id. Null when the Profile has not watched this movie.
    """
    lastWatchedAt: String
    "The library that holds this movie."
    library: Library!
    """
    True when this movie has no provider id, so no metadata provider matched it. Agrees with the
    unmatched filter on Library.items.
    """
    unmatched: Boolean!
}

type ContentRating {
    system: String!
    value: String!
    country: String!
}

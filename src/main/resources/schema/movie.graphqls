type Movie implements BaseCollectable {
    id: ID!
    createdBy: String
    createdOn: String!
    lastModifiedBy: String
    lastModifiedOn: String!
    title: String
    originalTitle: String
    titleSort: String
    tagline: String
    summary: String
    runtime: Int
    releaseDate: String
    contentRating: ContentRating
    files: [MediaFile]!
    studios: [Company]!
    cast: [Person]!
    directors: [Person]!
    genres: [Genre]!
    ratings: [Rating]!
    reviews: [Review]!
    images(type: ImageType): [Image]!
    "The selected Profile's state of this movie. Null when the request has no selected Profile."
    selectedProfileState: SelectedProfileState
    "The library that holds this movie."
    library: Library!
    """
    True when this movie has no provider id, so no metadata provider matched it. Agrees with the
    unmatched filter on Library.items.
    """
    unmatched: Boolean!
}

type ContentRating {
    system: String!
    value: String!
    country: String!
}

# Shared mutation error contract (ADR 0026). Every expected rejection a mutation can return is a
# member of that mutation's own error union; the members are declared once here and reused.

interface MutationError {
    message: String!
}

interface InputMutationError implements MutationError {
    message: String!
    "Path of the offending field relative to the mutation's input object; list indexes are decimal strings."
    inputPath: [String!]!
}

type InvalidIdError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryNameRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryPathRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryPathNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryPathNotDirectoryError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryPathNotReadableError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryPathAlreadyRegisteredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"Not the shape of an email address."
type EmailInvalidError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type AccountNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type HouseholdNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"The action requires recent password confirmation."
type ReauthenticationRequiredError implements MutationError {
    message: String!
}

type ReasonRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"An Account whose Personal Profile is restricted cannot administer the server, Household, or Profiles."
type RestrictedAccountCannotAdministerError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type MaximumAllowedRatingAgeInvalidError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"At least one enabled ServerAdmin must remain."
type LastServerAdminError implements MutationError {
    message: String!
}

"A Household always keeps at least one HouseholdAdmin until teardown."
type LastHouseholdAdminError implements MutationError {
    message: String!
}

type DisplayNameRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type HouseholdNameRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ProfileNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ProfileNameRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"Active Profile names are unique, ignoring case, within each Household."
type ProfileNameTakenError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"The Profile needs an eligible Profile manager in its Household."
type ProfileRequiresEligibleManagerError implements MutationError {
    message: String!
}

"""
The Account cannot manage the Profile: missing, outside the Household, its own Personal Profile
restricted, or not the Household role a restricted Profile requires.
"""
type ProfileManagerNotEligibleError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type InvalidProfilePinError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"The Profile must keep a PIN under its Household's safety policy."
type ProfilePinRequiredError implements MutationError {
    message: String!
    householdId: ID!
}

"Deletion needs an unlinked, unshared Profile and the caller as its sole remaining manager."
type ProfileNotDeletableError implements MutationError {
    message: String!
}

type EmailRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"An existing email cannot be invited or reassigned; transfer the Account instead."
type EmailAlreadyUsedError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"The first Account of an empty Household becomes HouseholdAdmin; it cannot be restricted."
type RestrictedFirstAccountError implements MutationError {
    message: String!
}

"A restricted Account holds no authority, so it cannot be invited as HouseholdAdmin."
type RestrictedHouseholdAdminError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"A restricted Profile needs a HouseholdAdmin with an unrestricted Personal Profile as its manager."
type EligibleProfileManagerRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type InvitationNotPendingError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ShareNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ShareNotPendingError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"The system withdrew the offer — its offerer lost the authority to make it — so it cannot be accepted; the offer's invalidationReason says why."
type OfferInvalidatedError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ShareNotActiveError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"The Profile is already available in that Household; a pending offer is replaced by a new one, not refused."
type ProfileAlreadySharedError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"A Household hosting a restricted Profile needs an eligible HouseholdAdmin."
type RestrictedProfileRequiresHouseholdAdminError implements MutationError {
    message: String!
}

"Another Profile in the target Household already uses the name."
type ShareNameConflictError implements MutationError {
    message: String!
}

"A share required by Account membership cannot end while the Account remains in the Household."
type MembershipShareCannotEndError implements MutationError {
    message: String!
}

type ConnectProfileRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ConnectProfileNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ProfileAlreadyLinkedError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ProfileNotInHouseholdError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ReofferHouseholdNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ReofferHouseholdNotSharedError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type AlreadyManagerError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"The invitation is unavailable."
type ManagerInvitationNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ManagementAlreadyRemovedError implements MutationError {
    message: String!
}

type NotAManagerError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}
type RegistrationNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type RegistrationNotActiveError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type EsnRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type EsnAlreadyBlockedError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type EsnBlockNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type SameHouseholdError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"The last Account in a Household must be handled through Household teardown."
type LastHouseholdAccountError implements MutationError {
    message: String!
}

"The Profile belongs to an Account; transfer or delete the Account instead."
type ProfileBelongsToAccountError implements MutationError {
    message: String!
}

type ReplacementManagerRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"Self-deletion is irreversible; the caller types the confirmation word deliberately."
type ConfirmationRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"Every other Account must already have been transferred or deleted."
type AccountsRemainError implements MutationError {
    message: String!
}

type LastAccountActionRequiredError implements MutationError {
    message: String!
}

type LastAccountActionNotAllowedError implements MutationError {
    message: String!
}

type DestinationRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type DestinationNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

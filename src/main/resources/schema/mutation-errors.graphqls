# Shared mutation error contract (ADR 0026). Every expected rejection a mutation can return is a
# member of that mutation's own error union; the members are declared once here and reused.

interface MutationError {
    message: String!
}

interface InputMutationError implements MutationError {
    message: String!
    "Path of the offending field relative to the mutation's input object; list indexes are decimal strings."
    inputPath: [String!]!
}

type InvalidIdError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryNameRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryPathRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryPathNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryPathNotDirectoryError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryPathNotReadableError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LibraryPathAlreadyRegisteredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type AccountNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type HouseholdNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"The action is allowed except for a current reauthentication ceremony (POST /api/auth/reauth)."
type ReauthenticationRequiredError implements MutationError {
    message: String!
}

type ReasonRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"An Account whose Personal Profile is restricted holds no administrative authority."
type RestrictedAccountAuthorityError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type MaximumAllowedRatingAgeInvalidError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"At least one enabled ServerAdmin must remain after bootstrap."
type LastServerAdminError implements MutationError {
    message: String!
}

"A Household always keeps at least one HouseholdAdmin until teardown."
type LastHouseholdAdminError implements MutationError {
    message: String!
}

type DisplayNameRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type HouseholdNameRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ProfileNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type ProfileNameRequiredError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"Active Profile names are unique, ignoring case, within each Household."
type ProfileNameTakenError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"Every Profile keeps an eligible home management anchor in the Household it belongs to."
type HomeAnchorRequiredError implements MutationError {
    message: String!
}

"An Account whose Personal Profile is restricted cannot hold manager authority."
type ManagerNotEligibleError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type LocalManagerNotFoundError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

type PinMalformedError implements InputMutationError & MutationError {
    message: String!
    inputPath: [String!]!
}

"Clearing this PIN would lock the Profile where a Household's safety policy requires one."
type WouldLockProfileError implements MutationError {
    message: String!
    householdId: ID!
}

"Deletion needs an unlinked, unshared Profile and the caller as its sole remaining manager."
type ProfileNotDeletableError implements MutationError {
    message: String!
}

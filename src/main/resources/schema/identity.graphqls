type Me {
    accountId: ID!
    email: String!
    displayName: String!
    role: String!
    homeHouseholdId: ID!
    householdRole: HouseholdRoleInput!
    scope: String!
    profiles: [SelectableProfile!]!
}

type SelectableProfile {
    id: ID!
    name: String!
    active: Boolean!
    pinProtected: Boolean!
}

type PortableProfileSummary {
    id: ID!
    name: String!
    kind: ProfileKind!
    maximumAllowedRatingAge: Int
    pinProtected: Boolean!
}

type PortableProfileShare {
    id: ID!
    profileId: ID!
    householdId: ID!
    status: ProfileShareStatus!
}

type PortableProfileManager {
    id: ID!
    accountId: ID!
    profileId: ID!
}

type PortableProfileManagerInvitation {
    id: ID!
    profileId: ID!
    invitingAccountId: ID!
    invitedAccountId: ID!
    status: ProfileManagerInvitationStatus!
}

enum ProfileKind {
    KID
    ADULT
}

enum ProfileShareStatus {
    PENDING
    ACTIVE
}

enum ProfileManagerInvitationStatus {
    PENDING
    ACCEPTED
    REJECTED
    CANCELED
}

enum HouseholdRoleInput {
    OWNER
    PARENT
    MEMBER
}

enum ProfileManagerOverrideActionInput {
    GRANT
    REMOVE
}

input PortableProfileCreationInput {
    name: String!
    kind: ProfileKind!
    maximumAllowedRatingAge: Int
    pin: String
}

input PortableProfileRenameInput {
    profileId: ID!
    name: String!
}

input ProfileShareOfferInput {
    profileId: ID!
    targetHouseholdId: ID!
}

input ProfileShareAcceptanceInput {
    shareId: ID!
    managementInvitationId: ID
}

input ProfileManagerInviteInput {
    profileId: ID!
    invitedAccountId: ID!
}

input ProfileManagerInvitationAcceptanceInput {
    invitationId: ID!
}

input ProfileReferenceInput {
    profileId: ID!
}

input ProfileKindChangeInput {
    profileId: ID!
    kind: ProfileKind!
}

input ProfileContentCeilingChangeInput {
    profileId: ID!
    maximumAllowedRatingAge: Int!
}

input ProfilePinResetInput {
    profileId: ID!
    newPin: String!
}

input ProfileDeletionInput {
    profileId: ID!
    password: String!
}

input ForceProfileDeletionInput {
    profileId: ID!
    password: String!
    reason: String!
}

input ForceProfileUnshareInput {
    shareId: ID!
    password: String!
    reason: String!
}

input ProfileManagerOverrideInput {
    profileId: ID!
    targetAccountId: ID!
    action: ProfileManagerOverrideActionInput!
    password: String!
    reason: String!
}

input AccountHouseholdTransferInput {
    targetAccountId: ID!
    targetHouseholdId: ID!
    targetRole: HouseholdRoleInput!
    password: String!
    reason: String!
}

input HouseholdOwnershipTransferInput {
    householdId: ID!
    targetAccountId: ID!
    password: String!
    reason: String!
}

vars {
  BASE_URL: http://localhost:8080
  TMDB_BASE_URL: https://api.themoviedb.org/3
  AUTH_DISPLAY_NAME: Bruno Admin
  AUTH_DEVICE_NAME: Bruno
  AUTH_HOUSEHOLD_NAME: Example Household
  AUTH_PROFILE_NAME: Example Profile
  PROFILE_ID: replace-with-profile-id
  LIBRARY_NAME: Movies
  LIBRARY_PATH: /path/to/media
  LIBRARY_ID: replace-with-library-id
  MEDIA_FILE_ID: replace-with-media-file-id
}
vars:secret [
  AUTH_EMAIL,
  AUTH_PASSWORD,
  AUTH_NEW_PASSWORD,
  PROFILE_PIN,
  TMDB_TOKEN
]

meta {
  name: Logout
  type: http
  seq: 4
  tags: [
    manual
    stateful
  ]
}

post {
  url: {{BASE_URL}}/api/auth/refresh/revoke
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "refreshToken": "{{REFRESH_TOKEN}}"
  }
}

script:pre-request {
  const csrfToken =
    bru.cookies.get("__Host-XSRF-TOKEN") || bru.cookies.get("XSRF-TOKEN");
  if (csrfToken) {
    req.setHeader("X-XSRF-TOKEN", csrfToken);
  }
}

script:post-response {
  if (res.status === 204) {
    bru.deleteVar("ACCESS_TOKEN");
    bru.deleteVar("REFRESH_TOKEN");
  }
}

tests {
  test("Should revoke the authenticated session", function() {
    expect(res.status).to.equal(204);
  });
}

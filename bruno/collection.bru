script:pre-request {
  // A machine-specific server address lives in the git-ignored bruno/.env (see .env.sample),
  // never in the committed environment. Without one, the collection targets localhost.
  bru.setVar(
    "LOCAL_BASE_URL",
    bru.getProcessEnv("STREAMARR_BASE_URL") || "http://localhost:8080"
  );
}

meta {
  name: Get Me
  type: graphql
  seq: 8
}

post {
  url: {{BASE_URL}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query {
    me {
      accountId
      email
      scope
      deviceBound
      contextHousehold {
        id
        name
      }
      selectedProfile {
        id
        pinConfigured
        locked
      }
      selectableProfiles(first: 100) {
        edges {
          node {
            id
            name
            kind
            personal
            pinConfigured
            locked
            selected
          }
        }
      }
    }
  }
}

script:post-response {
  if (res.status === 200 && res.body.data?.me) {
    const me = res.body.data.me;
    bru.setVar("HOUSEHOLD_ID", me.contextHousehold.id);
    const edges = me.selectableProfiles?.edges ?? [];
    const profiles = [me.selectedProfile, ...edges.map((edge) => edge.node)];
    const profile = profiles.find((candidate) =>
      candidate && !candidate.locked && !candidate.pinConfigured
    );
    bru.setVar("PROFILE_ID", profile?.id ?? "");
  }
}

tests {
  test("Should return the authenticated identity and its context Household", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.not.have.property("errors");
    const me = res.body.data.me;
    expect(me.accountId).to.be.a("string");
    expect(me.email).to.be.a("string");
    expect(me.scope).to.be.oneOf(["ACCOUNT", "HOUSEHOLD", "PROFILE"]);
    expect(me.deviceBound).to.be.a("boolean");
    expect(me.contextHousehold.id).to.be.a("string");
    expect(me.contextHousehold.name).to.be.a("string");
    expect(bru.getVar("HOUSEHOLD_ID")).to.equal(me.contextHousehold.id);
  });

  test("Should chain only a Profile usable without a PIN", function() {
    const me = res.body.data.me;
    const edges = me.selectableProfiles?.edges ?? [];
    const profiles = [me.selectedProfile, ...edges.map((edge) => edge.node)].filter(Boolean);
    const profileId = bru.getVar("PROFILE_ID");
    if (!profileId) {
      expect(profiles).to.satisfy((candidates) =>
        candidates.every((profile) => profile.locked || profile.pinConfigured)
      );
      return;
    }

    const chainedProfile = profiles.find((profile) => profile.id === profileId);
    expect(chainedProfile).to.not.equal(undefined);
    expect(chainedProfile.locked).to.equal(false);
    expect(chainedProfile.pinConfigured).to.equal(false);
  });
}

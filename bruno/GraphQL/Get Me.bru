meta {
  name: Get Me
  type: graphql
  seq: 8
}

post {
  url: {{BASE_URL}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query {
    me {
      accountId
      email
      displayName
      role
      scope
      profiles {
        id
        name
        active
      }
    }
  }
}

script:post-response {
  if (res.status === 200 && res.body.data?.me?.profiles?.length) {
    bru.setVar("PROFILE_ID", res.body.data.me.profiles[0].id);
  }
}

tests {
  test("Should return the authenticated identity and flat selectable profiles", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.not.have.property("errors");
    expect(res.body.data.me.accountId).to.be.a("string");
    expect(res.body.data.me.profiles).to.be.an("array");
  });
}

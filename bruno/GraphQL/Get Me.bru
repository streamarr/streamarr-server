meta {
  name: Get Me
  type: graphql
  seq: 8
}

post {
  url: {{BASE_URL}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query {
    me {
      accountId
      email
      scope
      deviceBound
      contextHousehold {
        id
        name
      }
      selectableProfiles(first: 100) {
        edges {
          node {
            id
            name
            kind
            personal
            pinConfigured
            locked
            selected
          }
        }
      }
    }
  }
}

script:post-response {
  if (res.status === 200 && res.body.data?.me) {
    const me = res.body.data.me;
    bru.setVar("HOUSEHOLD_ID", me.contextHousehold.id);
    const edges = me.selectableProfiles?.edges ?? [];
    if (edges.length) {
      bru.setVar("PROFILE_ID", edges[0].node.id);
    }
  }
}

tests {
  test("Should return the authenticated identity and its context Household", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.not.have.property("errors");
    expect(res.body.data.me.accountId).to.be.a("string");
    expect(res.body.data.me.contextHousehold.id).to.be.a("string");
  });
}

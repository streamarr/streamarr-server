meta {
  name: Create Stream Session
  type: graphql
  seq: 6
}

post {
  url: {{BASE_URL}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation CreatePlaybackSession(
    $mediaFileId: ID!
    $capabilities: ClientCapabilityDeclarationInput!
  ) {
    createPlaybackSession(input: { mediaFileId: $mediaFileId, capabilities: $capabilities }) {
      playbackSession {
        id
        formatAttemptCount
        maximumFormatAttempts
        currentFormatAttempt {
          __typename
          ... on PendingPlaybackFormatAttempt {
            streamSessionId
          }
          ... on ReadyPlaybackFormatAttempt {
            streamSession {
              id
              streamUrl
              transcodeMode
            }
          }
          ... on FailedPlaybackFormatAttempt {
            streamSessionId
            error {
              __typename
              ... on MutationError {
                message
              }
            }
          }
        }
      }
      userErrors {
        __typename
        ... on MutationError {
          message
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "mediaFileId": "{{MEDIA_FILE_ID}}",
    "capabilities": {
      "video": [
        {
          "codecFamily": "H264",
          "codecProfiles": [
            { "profile": "H264_CONSTRAINED_BASELINE", "maxLevel": 51 },
            { "profile": "H264_MAIN", "maxLevel": 51 },
            { "profile": "H264_HIGH", "maxLevel": 51 }
          ],
          "maxBitDepth": 8,
          "maxWidth": 3840,
          "maxHeight": 2160,
          "maxFrameRate": 60,
          "compatibleBases": ["SDR"],
          "dolbyVisionProfiles": [],
          "hdr10Plus": false,
          "hls": true
        }
      ],
      "audio": [
        { "codec": "AAC", "maxChannels": 2, "hls": true }
      ]
    }
  }
}

script:post-response {
  const payload = res.body?.data?.createPlaybackSession;
  const session = res.status === 200 && !res.body?.errors?.length && payload?.userErrors?.length === 0
    ? payload.playbackSession
    : undefined;
  const stream = session?.currentFormatAttempt?.__typename === "ReadyPlaybackFormatAttempt"
    ? session.currentFormatAttempt.streamSession
    : undefined;
  bru.setVar("PLAYBACK_SESSION_ID", session?.id ?? "");
  bru.setVar("STREAM_SESSION_ID", stream?.id ?? "");
  bru.setVar("STREAM_URL", stream?.streamUrl ?? "");
  bru.setVar("PLAYBACK_TOKEN", stream?.streamUrl?.match(/[?&]t=([^&\s]+)/)?.[1] ?? "");
}

tests {
  test("Should create a playback session", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.not.have.property("errors");
    expect(res.body.data.createPlaybackSession.userErrors).to.be.empty;
    expect(res.body.data.createPlaybackSession.playbackSession.id).to.be.a("string");
  });
}

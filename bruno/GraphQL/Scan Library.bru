meta {
  name: Scan Library
  type: graphql
  seq: 4
}

post {
  url: {{BASE_URL}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation StartLibraryScan($input: StartLibraryScanInput!) {
    startLibraryScan(input: $input) {
      library {
        id
        administration {
          status
        }
      }
      userErrors {
        __typename
        ... on MutationError {
          message
        }
        ... on LibraryBusyError {
          status
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "libraryId": "{{LIBRARY_ID}}"
    }
  }
}

tests {
  // The first scan from Create Library can still run, and then the library refuses this scan.
  test("Should start a library scan or report the running operation", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.not.have.property("errors");
    const payload = res.body.data.startLibraryScan;
    if (payload.userErrors.length === 0) {
      expect(payload.library.administration.status).to.equal("SCANNING");
      return;
    }
    expect(payload.library).to.equal(null);
    expect(payload.userErrors[0].__typename).to.equal("LibraryBusyError");
  });
}

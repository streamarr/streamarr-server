meta {
  name: Delete Library
  type: graphql
  seq: 7
  tags: [
    destructive
  ]
}

post {
  url: {{BASE_URL}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation RemoveLibrary($input: RemoveLibraryInput!) {
    removeLibrary(input: $input) {
      removedLibraryId
      userErrors {
        __typename
        ... on MutationError {
          message
        }
        ... on LibraryBusyError {
          status
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "libraryId": "{{LIBRARY_ID}}"
    }
  }
}

tests {
  // A library refuses removal while a scan or a refresh runs. Wait for the operation to end, then retry.
  test("Should delete a library", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.not.have.property("errors");
    expect(res.body.data.removeLibrary.userErrors).to.deep.equal([]);
    expect(res.body.data.removeLibrary.removedLibraryId).to.equal(bru.getVar("LIBRARY_ID"));
  });
}

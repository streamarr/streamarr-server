meta {
  name: Create Profile
  type: graphql
  seq: 10
}

post {
  url: {{BASE_URL}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation {
    createProfile(
      input: {
        householdId: "{{HOUSEHOLD_ID}}"
        name: "{{NEW_PROFILE_NAME}}"
        kind: ADULT
      }
    ) {
      profile {
        id
        name
        kind
        pinConfigured
      }
      userErrors {
        __typename
        ... on MutationError {
          message
        }
      }
    }
  }
}

script:post-response {
  const profile = res.body.data?.createProfile?.profile;
  if (profile) {
    bru.setVar("NEW_PROFILE_ID", profile.id);
  }
}

tests {
  test("Should create the Profile with no user errors", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.not.have.property("errors");
    expect(res.body.data.createProfile.userErrors).to.be.empty;
    const profile = res.body.data.createProfile.profile;
    expect(profile.id).to.be.a("string");
    expect(profile.name).to.equal(bru.getEnvVar("NEW_PROFILE_NAME"));
    expect(profile.kind).to.equal("ADULT");
    expect(profile.pinConfigured).to.equal(false);
    expect(bru.getVar("NEW_PROFILE_ID")).to.equal(profile.id);
  });
}

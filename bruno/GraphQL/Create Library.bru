meta {
  name: Create Library
  type: graphql
  seq: 3
}

post {
  url: {{BASE_URL}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AddLibrary($input: AddLibraryInput!) {
    addLibrary(input: $input) {
      library {
        id
        name
        administration {
          status
        }
      }
      userErrors {
        __typename
        ... on MutationError {
          message
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "name": "{{LIBRARY_NAME}}",
      "filepath": "{{LIBRARY_PATH}}",
      "type": "MOVIE",
      "backend": "LOCAL",
      "externalAgentStrategy": "TMDB"
    }
  }
}

script:post-response {
  if (res.status === 200 && res.body.data?.addLibrary?.library?.id) {
    bru.setVar("LIBRARY_ID", res.body.data.addLibrary.library.id);
  }
}

tests {
  test("Should create a library and start its first scan", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.not.have.property("errors");
    expect(res.body.data.addLibrary.userErrors).to.deep.equal([]);
    expect(res.body.data.addLibrary.library.id).to.be.a("string");
    expect(res.body.data.addLibrary.library.administration.status).to.equal("SCANNING");
  });
}
